# ── Local dev ──────────────────────────────────────────────
# Leave empty — Vite proxies /api/* to http://localhost:5000 (see vite.config.ts)
# VITE_API_URL=

# ── Production (Vercel) ────────────────────────────────────
# Optional — production builds fall back to https://snapfeed-ai.onrender.com automatically.
# Set in Vercel → Project → Settings → Environment Variables only if you use a custom API host.
# VITE_API_URL=https://snapfeed-ai.onrender.com

# ── Supabase Auth ──────────────────────────────────────────
# Project Settings → API in Supabase Dashboard
# Use publishable key (sb_publishable_...) or legacy anon key (eyJ...)
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# ── Support ────────────────────────────────────────────────
# Prefer a company-domain inbox for US Ads trust (shown in footer + legal pages)
# VITE_SUPPORT_EMAIL=supportstratum@gmail.com

# ── Google Ads (loaded only after cookie “Accept”) ─────────
# Ads → Goals → Conversions → Tag setup → Use Google tag
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
# Conversion “send to” values look like AW-XXXXXXXXX/abcdefgHI
# VITE_GOOGLE_ADS_CONVERSION_SIGNUP=AW-XXXXXXXXX/signup_label
# VITE_GOOGLE_ADS_CONVERSION_GENERATE=AW-XXXXXXXXX/generate_label
# VITE_GOOGLE_ADS_CONVERSION_PURCHASE=AW-XXXXXXXXX/purchase_label
